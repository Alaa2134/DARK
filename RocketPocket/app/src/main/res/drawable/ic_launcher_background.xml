<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background. A gradient rather than the flat #07090D used before: against a
    dark launcher wallpaper that near-black square was indistinguishable from empty space, so
    the app looked as though it had no icon at all.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#1E2A44"
                android:centerColor="#141C2C"
                android:endColor="#07090D" />
        </aapt:attr>
    </path>
</vector>
